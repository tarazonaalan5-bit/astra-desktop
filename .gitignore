* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  width: 100%;
  height: 100%;
  font-family: Inter, system-ui, sans-serif;
  background: #020817;
  color: #e2e8f0;
}

body {
  min-height: 100vh;
}

button, input, select {
  font: inherit;
}

.app-shell {
  display: flex;
  width: 100vw;
  height: 100vh;
  background: #020817;
  overflow: hidden;
}

.sidebar {
  width: 280px;
  background: #0f172a;
  border-right: 1px solid #1e293b;
  padding: 20px 16px;
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 24px;
}

.brand-logo {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #8b5cf6, #3b82f6);
  color: white;
  font-weight: 800;
}

.brand-title {
  font-size: 1.3rem;
  font-weight: 800;
}

.brand-subtitle {
  color: #94a3b8;
  font-size: 0.8rem;
}

.panel-block {
  margin-bottom: 16px;
}

.field-label {
  display: block;
  margin-bottom: 8px;
  color: #cbd5e1;
  font-size: 0.82rem;
}

.status-box {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(148, 163, 184, 0.08);
  border: 1px solid #1e293b;
  border-radius: 10px;
  padding: 10px 12px;
  color: #e2e8f0;
}

.status-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #ef4444;
  display: inline-block;
  box-shadow: 0 0 12px rgba(239, 68, 68, 0.7);
}

.status-dot[data-live='true'] {
  background: #22c55e;
  box-shadow: 0 0 12px rgba(34, 197, 94, 0.7);
}

.soft-btn {
  width: 100%;
  background: #1e293b;
  color: #e2e8f0;
  border: 1px solid #334155;
  border-radius: 10px;
  padding: 11px 14px;
  cursor: pointer;
  margin-top: 8px;
}

.soft-btn.small {
  width: auto;
  margin-top: 0;
  padding: 10px 12px;
}

.main-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 22px;
  border-bottom: 1px solid #1e293b;
  background: rgba(15, 23, 42, 0.9);
}

.topbar-title {
  font-size: 1.2rem;
  font-weight: 800;
}

.topbar-subtitle {
  color: #94a3b8;
  font-size: 0.78rem;
}

.topbar-status {
  color: #cbd5e1;
  font-size: 0.9rem;
}

.workspace {
  display: flex;
  flex: 1;
  min-height: 0;
}

.chat-panel {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  border-right: 1px solid #1e293b;
}

.chat-header {
  padding: 18px 20px 12px;
  color: #cbd5e1;
  font-weight: 700;
  border-bottom: 1px solid #1e293b;
}

.messages-box {
  flex: 1;
  overflow-y: auto;
  padding: 18px 20px;
  background: #0b1220;
}

.message-card {
  background: rgba(30, 41, 59, 0.75);
  border: 1px solid #1e293b;
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 12px;
}

.message-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
  color: #cbd5e1;
  font-size: 0.82rem;
}

.message-body {
  color: #f8fafc;
  line-height: 1.5;
  word-break: break-word;
}

.composer {
  display: flex;
  gap: 12px;
  padding: 12px 16px 16px;
  border-top: 1px solid #1e293b;
  background: #0f172a;
}

.browser-panel {
  width: 420px;
  min-width: 320px;
  display: flex;
  flex-direction: column;
  background: #0b1220;
}

.browser-header {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 14px 12px;
  border-bottom: 1px solid #1e293b;
}

.browser-frame-wrap {
  flex: 1;
  padding: 12px;
}

.browser-frame {
  width: 100%;
  height: 100%;
  background: white;
  border: 1px solid #334155;
  border-radius: 12px;
}

@media (max-width: 1000px) {
  .workspace {
    flex-direction: column;
  }

  .browser-panel {
    width: 100%;
    min-width: 0;
    height: 50%;
  }
}
